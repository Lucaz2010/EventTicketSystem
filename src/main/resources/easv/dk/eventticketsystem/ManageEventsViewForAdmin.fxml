<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="eventPane" prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="easv.dk.eventticketsystem.gui.controllers.ManageEventsControllerForAdmin">
    <!-- Left Sidebar -->
    <left>
        <fx:include source="components/Sidebar.fxml" />
    </left>
    <center>
        <VBox prefWidth="1000.0" spacing="10">
            <!-- Top: Toolbar -->
            <AnchorPane fx:id="toolbarContainer" />
            <!--<fx:include source="components/Toolbar.fxml" />-->

            <!-- Container for the Create button aligned to right -->
            <HBox alignment="CENTER_RIGHT" prefHeight="34.0" prefWidth="1000.0">
                <VBox.margin>
                    <Insets />
                </VBox.margin>
            </HBox>
            <!-- ScrollPane wrapping FlowPane -->
            <ScrollPane fitToWidth="true" prefHeight="650.0" prefWidth="1000.0">
                <content>
                    <FlowPane fx:id="eventCardPane" alignment="TOP_CENTER" hgap="20.0" vgap="20.0">
                        <VBox.margin>
                            <Insets top="20.0" />
                        </VBox.margin>
                    </FlowPane>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
